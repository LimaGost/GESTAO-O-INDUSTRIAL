{
  "name": "Perda",
  "type": "object",
  "properties": {
    "produto_nome": {
      "type": "string"
    },
    "produto_id": {
      "type": "string"
    },
    "quantidade": {
      "type": "number",
      "default": 0
    },
    "motivo": {
      "type": "string"
    },
    "data": {
      "type": "string",
      "format": "date"
    },
    "ordem_producao_id": {
      "type": "string"
    }
  },
  "required": [
    "produto_nome",
    "motivo"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "diretor"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "diretor"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        },
        {
          "user_condition": {
            "role": "maquinista"
          }
        },
        {
          "user_condition": {
            "role": "embalador"
          }
        },
        {
          "user_condition": {
            "role": "estoquista"
          }
        },
        {
          "user_condition": {
            "role": "estoquista_industria"
          }
        },
        {
          "user_condition": {
            "role": "estoquista_galpao"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "diretor"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "diretor"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        }
      ]
    }
  }
}