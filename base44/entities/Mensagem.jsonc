{
  "name": "Mensagem",
  "type": "object",
  "properties": {
    "conversa_id": {
      "type": "string",
      "description": "ID da conversa \u00e0 qual pertence"
    },
    "remetente_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que enviou"
    },
    "remetente_nome": {
      "type": "string",
      "description": "Nome do usu\u00e1rio que enviou"
    },
    "conteudo": {
      "type": "string",
      "description": "Conte\u00fado da mensagem"
    },
    "lida": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "conversa_id",
    "remetente_id",
    "conteudo"
  ],
  "rls": {
    "create": {
      "data.remetente_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.remetente_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.remetente_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.remetente_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}