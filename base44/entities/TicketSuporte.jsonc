{
  "name": "TicketSuporte",
  "type": "object",
  "properties": {
    "tipo": {
      "type": "string"
    },
    "titulo": {
      "type": "string"
    },
    "descricao": {
      "type": "string"
    },
    "prioridade": {
      "type": "string",
      "default": "media"
    },
    "status": {
      "type": "string",
      "enum": [
        "aberto",
        "em_atendimento",
        "respondido",
        "fechado",
        "cancelado"
      ],
      "default": "aberto"
    },
    "usuario_nome": {
      "type": "string"
    },
    "usuario_email": {
      "type": "string"
    },
    "resposta": {
      "type": "string"
    },
    "respondido_por": {
      "type": "string"
    },
    "data_resposta": {
      "type": "string"
    },
    "discord_message_id": {
      "type": "string"
    },
    "discord_thread_id": {
      "type": "string"
    },
    "historico_respostas": {
      "type": "array",
      "description": "Hist\u00f3rico de todas as respostas trocadas",
      "items": {
        "type": "object",
        "properties": {
          "mensagem": {
            "type": "string"
          },
          "respondido_por": {
            "type": "string"
          },
          "data": {
            "type": "string"
          },
          "origem": {
            "type": "string",
            "description": "sistema ou discord"
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "titulo",
    "descricao",
    "tipo"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.usuario_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}