{
  "name": "Expedicao",
  "type": "object",
  "properties": {
    "numero_nf": {
      "type": "string"
    },
    "pedido_id": {
      "type": "string"
    },
    "pedido_numero": {
      "type": "string"
    },
    "ordem_producao_id": {
      "type": "string"
    },
    "cliente_id": {
      "type": "string"
    },
    "cliente_nome": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "emitida",
        "enviada",
        "entregue"
      ],
      "default": "emitida"
    },
    "data_emissao": {
      "type": "string",
      "format": "date"
    },
    "data_envio": {
      "type": "string"
    },
    "data_entrega": {
      "type": "string"
    },
    "transportadora": {
      "type": "string"
    },
    "confirmado_pelo_cliente": {
      "type": "boolean",
      "default": false
    },
    "data_confirmacao": {
      "type": "string"
    },
    "valor_total": {
      "type": "number",
      "default": 0
    },
    "itens": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "cliente_nome"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        },
        {
          "user_condition": {
            "role": "motorista"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        },
        {
          "user_condition": {
            "role": "motorista"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        },
        {
          "user_condition": {
            "role": "motorista"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        }
      ]
    }
  }
}