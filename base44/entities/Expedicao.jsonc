{
  "name": "Expedicao",
  "type": "object",
  "properties": {
    "numero_nf": {
      "type": "string"
    },
    "pedido_id": {
      "type": "string"
    },
    "pedido_numero": {
      "type": "string"
    },
    "ordem_producao_id": {
      "type": "string"
    },
    "cliente_id": {
      "type": "string"
    },
    "cliente_nome": {
      "type": "string"
    },
    "cliente_endereco": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "emitida",
        "enviada",
        "entregue"
      ],
      "default": "emitida"
    },
    "data_emissao": {
      "type": "string",
      "format": "date"
    },
    "data_envio": {
      "type": "string"
    },
    "data_entrega": {
      "type": "string"
    },
    "transportadora": {
      "type": "string"
    },
    "confirmado_pelo_cliente": {
      "type": "boolean",
      "default": false
    },
    "data_confirmacao": {
      "type": "string"
    },
    "data_confirmacao_cliente": {
      "type": "string",
      "description": "Data/hora em que o cliente confirmou o recebimento"
    },
    "token_confirmacao": {
      "type": "string",
      "description": "Token do link p\u00fablico de confirma\u00e7\u00e3o de recebimento"
    },
    "nome_recebedor": {
      "type": "string",
      "description": "Nome de quem recebeu a mercadoria"
    },
    "cpf_recebedor": {
      "type": "string"
    },
    "observacoes_cliente": {
      "type": "string"
    },
    "assinatura_url": {
      "type": "string",
      "description": "URL da imagem da assinatura do recebedor"
    },
    "foto_recebedor_url": {
      "type": "string",
      "description": "URL da foto do recebimento"
    },
    "valor_total": {
      "type": "number",
      "default": 0
    },
    "itens": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "cliente_nome"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        },
        {
          "user_condition": {
            "role": "motorista"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        },
        {
          "user_condition": {
            "role": "motorista"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "vendedor_industria"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "vendedor_loja"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "estoquista_galpao"
          }
        },
        {
          "user_condition": {
            "role": "conferente_industria"
          }
        },
        {
          "user_condition": {
            "role": "conferente_galpao"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        },
        {
          "user_condition": {
            "role": "motorista"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        }
      ]
    }
  }
}