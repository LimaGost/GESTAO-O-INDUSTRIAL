{
  "name": "Notificacao",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string"
    },
    "descricao": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "pedido",
        "estoque",
        "producao",
        "cliente",
        "suporte"
      ],
      "default": "pedido"
    },
    "lida": {
      "type": "boolean",
      "default": false
    },
    "link": {
      "type": "string"
    },
    "usuario_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio destinat\u00e1rio da notifica\u00e7\u00e3o"
    }
  },
  "required": [
    "titulo"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.usuario_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.usuario_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.usuario_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.usuario_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}