      },
      "default": []
    },
    "variacoes": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "lote": {
      "type": "string"
    },
    "pedido_id": {
      "type": "string"
    },
    "pedido_numero": {
      "type": "string"
    },
    "origem": {
      "type": "string"
    },
    "observacoes": {
      "type": "string"
    },
    "data_inicio": {
      "type": "string"
    },
    "data_fim_producao": {
      "type": "string"
    },
    "data_embalagem": {
      "type": "string"
    },
    "data_finalizacao": {
      "type": "string"
    }
