{
  "name": "OrdemProducao",
  "type": "object",
  "properties": {
    "numero": {
      "type": "string"
    },
    "produto_id": {
      "type": "string"
    },
    "produto_nome": {
      "type": "string"
    },
    "quantidade": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "default": "a_produzir"
    },
    "itens": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "variacoes": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "lote": {
      "type": "string"
    },
    "pedido_id": {
      "type": "string"
    },
    "pedido_numero": {
      "type": "string"
    },
    "grupo_id": {
      "type": "string",
      "description": "ID do GrupoPedidos que originou esta OP"
    },
    "grupo_cliente_nome": {
      "type": "string",
      "description": "Nome do cliente do grupo de origem"
    },
    "origem": {
      "type": "string"
    },
    "observacoes": {
      "type": "string"
    },
    "data_inicio": {
      "type": "string"
    },
    "data_fim_producao": {
      "type": "string"
    },
    "data_embalagem": {
      "type": "string"
    },
    "data_finalizacao": {
      "type": "string"
    }
  },
  "required": [
    "produto_nome"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        },
        {
          "user_condition": {
            "role": "estoquista"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        },
        {
          "user_condition": {
            "role": "maquinista"
          }
        },
        {
          "user_condition": {
            "role": "embalador"
          }
        },
        {
          "user_condition": {
            "role": "estoquista"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        },
        {
          "user_condition": {
            "role": "maquinista"
          }
        },
        {
          "user_condition": {
            "role": "embalador"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        }
      ]
    }
  }
}