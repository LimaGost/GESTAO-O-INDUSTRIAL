{
  "name": "OrdemProducao",
  "type": "object",
  "properties": {
    "numero": {
      "type": "string"
    },
    "produto_id": {
      "type": "string"
    },
    "produto_nome": {
      "type": "string"
    },
    "quantidade": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "default": "a_produzir"
    },
    "itens": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "variacoes": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "lote": {
      "type": "string"
    },
    "pedido_id": {
      "type": "string"
    },
    "pedido_numero": {
      "type": "string"
    },
    "grupo_id": {
      "type": "string",
      "description": "ID do GrupoPedidos que originou esta OP"
    },
    "grupo_cliente_nome": {
      "type": "string",
      "description": "Nome do cliente do grupo de origem"
    },
    "origem": {
      "type": "string"
    },
    "observacoes": {
      "type": "string"
    },
    "quantidade_pedido_total": {
      "type": "number",
      "description": "Quantidade total do pedido de origem (estoque + produ\u00e7\u00e3o)"
    },
    "quantidade_reservada_estoque": {
      "type": "number",
      "default": 0,
      "description": "Quantidade j\u00e1 reservada em estoque quando a OP foi criada (aloca\u00e7\u00e3o parcial)"
    },
    "separacao_id": {
      "type": "string",
      "description": "ID da Separa\u00e7\u00e3o aguardando esta produ\u00e7\u00e3o (aloca\u00e7\u00e3o parcial)"
    },
    "data_inicio": {
      "type": "string"
    },
    "data_fim_producao": {
      "type": "string"
    },
    "data_embalagem": {
      "type": "string"
    },
    "data_finalizacao": {
      "type": "string"
    }
  },
  "required": [
    "produto_nome"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        },
        {
          "user_condition": {
            "role": "estoquista"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        },
        {
          "user_condition": {
            "role": "estoquista_industria"
          }
        },
        {
          "user_condition": {
            "role": "vendedor_industria"
          }
        },
        {
          "user_condition": {
            "role": "vendedor_loja"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "diretor"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        },
        {
          "user_condition": {
            "role": "maquinista"
          }
        },
        {
          "user_condition": {
            "role": "embalador"
          }
        },
        {
          "user_condition": {
            "role": "estoquista"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        },
        {
          "user_condition": {
            "role": "estoquista_industria"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "vendedor_industria"
              }
            },
            {
              "$or": [
                {
                  "created_by_id": "{{user.id}}"
                },
                {
                  "data.origem": "bling"
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "vendedor_loja"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "conferente_industria"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        },
        {
          "user_condition": {
            "role": "maquinista"
          }
        },
        {
          "user_condition": {
            "role": "embalador"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        }
      ]
    }
  }
}