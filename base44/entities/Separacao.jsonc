{
  "name": "Separacao",
  "type": "object",
  "properties": {
    "numero": {
      "type": "string",
      "description": "N\u00famero da separa\u00e7\u00e3o (ex: SEP-...)"
    },
    "origem": {
      "type": "string",
      "enum": [
        "pedido",
        "grupo",
        "ordem_producao"
      ],
      "description": "Origem da separa\u00e7\u00e3o"
    },
    "pedido_id": {
      "type": "string"
    },
    "pedido_numero": {
      "type": "string"
    },
    "grupo_id": {
      "type": "string"
    },
    "grupo_cliente_nome": {
      "type": "string"
    },
    "ordem_producao_id": {
      "type": "string"
    },
    "ordem_producao_numero": {
      "type": "string"
    },
    "cliente_id": {
      "type": "string"
    },
    "cliente_nome": {
      "type": "string"
    },
    "white_label": {
      "type": "boolean",
      "default": false
    },
    "white_label_marca": {
      "type": "string"
    },
    "sem_rotulo": {
      "type": "boolean",
      "default": false,
      "description": "Separa\u00e7\u00e3o sem r\u00f3tulo \u2014 itens entregues sem rotulagem"
    },
    "itens": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "quantidade_itens": {
      "type": "number",
      "default": 0
    },
    "quantidade_total": {
      "type": "number",
      "default": 0
    },
    "quantidade_pendente_producao": {
      "type": "number",
      "default": 0
    },
    "producao_concluida": {
      "type": "boolean",
      "default": false
    },
    "estoque_ja_reservado": {
      "type": "boolean",
      "default": false
    },
    "destino_tipo": {
      "type": "string",
      "enum": [
        "retirada_fabrica",
        "retirada_unidade",
        "transportadora",
        "entrega_cliente"
      ]
    },
    "destino_transportadora": {
      "type": "string"
    },
    "destino_unidade": {
      "type": "string"
    },
    "destino_endereco": {
      "type": "string"
    },
    "data_prevista": {
      "type": "string",
      "format": "date"
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "baixa",
        "normal",
        "alta"
      ],
      "default": "normal"
    },
    "status": {
      "type": "string",
      "enum": [
        "aguardando_producao",
        "aguardando_separacao",
        "em_separacao",
        "separado",
        "em_conferencia",
        "conferido",
        "liberado_expedicao"
      ],
      "default": "aguardando_separacao"
    },
    "data_inicio_separacao": {
      "type": "string"
    },
    "data_separado": {
      "type": "string"
    },
    "data_conferencia": {
      "type": "string"
    },
    "data_liberacao": {
      "type": "string"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "numero",
    "origem"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "diretor"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        },
        {
          "user_condition": {
            "role": "estoquista"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        },
        {
          "user_condition": {
            "role": "estoquista_industria"
          }
        },
        {
          "user_condition": {
            "role": "vendedor_industria"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "diretor"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        },
        {
          "user_condition": {
            "role": "estoquista"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        },
        {
          "user_condition": {
            "role": "maquinista"
          }
        },
        {
          "user_condition": {
            "role": "embalador"
          }
        },
        {
          "user_condition": {
            "role": "motorista"
          }
        },
        {
          "user_condition": {
            "role": "estoquista_industria"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "vendedor_industria"
              }
            },
            {
              "created_by_id": "{{user.id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "conferente_industria"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "diretor"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        },
        {
          "user_condition": {
            "role": "estoquista"
          }
        },
        {
          "user_condition": {
            "role": "embalador"
          }
        },
        {
          "user_condition": {
            "role": "maquinista"
          }
        },
        {
          "user_condition": {
            "role": "estoquista_industria"
          }
        },
        {
          "user_condition": {
            "role": "conferente_industria"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "diretor"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        }
      ]
    }
  }
}