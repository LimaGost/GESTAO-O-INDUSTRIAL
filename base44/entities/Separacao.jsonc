{
  "name": "Separacao",
  "type": "object",
  "properties": {
    "numero": {
      "type": "string",
      "description": "N\u00famero da separa\u00e7\u00e3o (ex: SEP-...)"
    },
    "origem": {
      "type": "string",
      "enum": [
        "pedido",
        "grupo",
        "ordem_producao"
      ],
      "description": "Origem da separa\u00e7\u00e3o"
    },
    "pedido_id": {
      "type": "string"
    },
    "pedido_numero": {
      "type": "string"
    },
    "grupo_id": {
      "type": "string"
    },
    "grupo_cliente_nome": {
      "type": "string"
    },
    "ordem_producao_id": {
      "type": "string"
    },
    "ordem_producao_numero": {
      "type": "string"
    },
    "cliente_id": {
      "type": "string"
    },
    "cliente_nome": {
      "type": "string"
    },
    "white_label": {
      "type": "boolean",
      "default": false
    },
    "white_label_marca": {
      "type": "string"
    },
    "itens": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "quantidade_itens": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de itens distintos"
    },
    "quantidade_total": {
      "type": "number",
      "default": 0,
      "description": "Soma das quantidades"
    },
    "quantidade_pendente_producao": {
      "type": "number",
      "default": 0,
      "description": "Quantidade aguardando conclus\u00e3o de produ\u00e7\u00e3o (aloca\u00e7\u00e3o parcial)"
    },
    "producao_concluida": {
      "type": "boolean",
      "default": false,
      "description": "Indica que a produ\u00e7\u00e3o pendente foi conclu\u00edda e as quantidades mescladas"
    },
    "estoque_ja_reservado": {
      "type": "boolean",
      "default": false,
      "description": "Estoque j\u00e1 foi baixado na reserva do pedido \u2014 n\u00e3o baixar novamente na libera\u00e7\u00e3o"
    },
    "destino_tipo": {
      "type": "string",
      "enum": [
        "retirada_fabrica",
        "retirada_unidade",
        "transportadora",
        "entrega_cliente"
      ]
    },
    "destino_transportadora": {
      "type": "string"
    },
    "destino_unidade": {
      "type": "string"
    },
    "destino_endereco": {
      "type": "string"
    },
    "data_prevista": {
      "type": "string",
      "format": "date",
      "description": "Data prevista de entrega"
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "baixa",
        "normal",
        "alta"
      ],
      "default": "normal"
    },
    "status": {
      "type": "string",
      "enum": [
        "aguardando_producao",
        "aguardando_separacao",
        "em_separacao",
        "separado",
        "em_conferencia",
        "conferido",
        "liberado_expedicao"
      ],
      "default": "aguardando_separacao"
    },
    "data_inicio_separacao": {
      "type": "string"
    },
    "data_separado": {
      "type": "string"
    },
    "data_conferencia": {
      "type": "string"
    },
    "data_liberacao": {
      "type": "string"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "numero",
    "origem"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        },
        {
          "user_condition": {
            "role": "estoquista"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        },
        {
          "user_condition": {
            "role": "estoquista_industria"
          }
        },
        {
          "user_condition": {
            "role": "vendedor_industria"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        },
        {
          "user_condition": {
            "role": "estoquista"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        },
        {
          "user_condition": {
            "role": "maquinista"
          }
        },
        {
          "user_condition": {
            "role": "embalador"
          }
        },
        {
          "user_condition": {
            "role": "motorista"
          }
        },
        {
          "user_condition": {
            "role": "estoquista_industria"
          }
        },
        {
          "user_condition": {
            "role": "vendedor_industria"
          }
        },
        {
          "user_condition": {
            "role": "conferente_industria"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        },
        {
          "user_condition": {
            "role": "estoquista"
          }
        },
        {
          "user_condition": {
            "role": "embalador"
          }
        },
        {
          "user_condition": {
            "role": "maquinista"
          }
        },
        {
          "user_condition": {
            "role": "estoquista_industria"
          }
        },
        {
          "user_condition": {
            "role": "conferente_industria"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        }
      ]
    }
  }
}