{
  "name": "Etiqueta",
  "type": "object",
  "properties": {
    "ordem_producao_id": {
      "type": "string"
    },
    "produto_id": {
      "type": "string"
    },
    "produto_nome": {
      "type": "string"
    },
    "quantidade": {
      "type": "number",
      "default": 0
    },
    "lote": {
      "type": "string"
    },
    "data_producao": {
      "type": "string",
      "format": "date"
    },
    "impresso": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "produto_nome"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        },
        {
          "user_condition": {
            "role": "embalador"
          }
        },
        {
          "user_condition": {
            "role": "estoquista"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        },
        {
          "user_condition": {
            "role": "embalador"
          }
        },
        {
          "user_condition": {
            "role": "estoquista"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        },
        {
          "user_condition": {
            "role": "embalador"
          }
        },
        {
          "user_condition": {
            "role": "estoquista"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        }
      ]
    }
  }
}