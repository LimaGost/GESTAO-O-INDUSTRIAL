{
  "name": "Tutorial",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do tutorial"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do que \u00e9 ensinado no v\u00eddeo"
    },
    "modulo": {
      "type": "string",
      "description": "M\u00f3dulo do sistema a que se refere (ex: Pedidos, Kanban, Expedi\u00e7\u00e3o)"
    },
    "video_url": {
      "type": "string",
      "description": "URL do v\u00eddeo enviado"
    },
    "ordem": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o dentro do m\u00f3dulo"
    },
    "ativo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "titulo",
    "video_url"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        }
      ]
    }
  }
}