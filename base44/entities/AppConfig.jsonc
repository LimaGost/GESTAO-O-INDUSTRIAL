{
  "name": "AppConfig",
  "type": "object",
  "properties": {
    "chave": {
      "type": "string",
      "description": "Identificador \u00fanico da configura\u00e7\u00e3o (ex: kanban_colunas, whatsapp_kanban)"
    },
    "valor": {
      "type": "object",
      "description": "Valor da configura\u00e7\u00e3o em formato JSON",
      "default": {}
    }
  },
  "required": [
    "chave"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}