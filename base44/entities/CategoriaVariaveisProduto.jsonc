{
  "name": "CategoriaVariaveisProduto",
  "type": "object",
  "properties": {
    "nome_categoria": {
      "type": "string",
      "description": "Nome da categoria de produtos"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da categoria"
    },
    "variaveis": {
      "type": "array",
      "description": "Lista de atributos customiz\u00e1veis para produtos desta categoria",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID \u00fanico da vari\u00e1vel"
          },
          "nome": {
            "type": "string",
            "description": "Nome da vari\u00e1vel (ex: Cor, Tamanho, Sabor)"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "texto",
              "numero",
              "select",
              "booleano"
            ],
            "description": "Tipo de dado da vari\u00e1vel"
          },
          "obrigatoria": {
            "type": "boolean",
            "default": false
          },
          "opcoes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Op\u00e7\u00f5es dispon\u00edveis se tipo \u00e9 'select'"
          },
          "valor_padrao": {
            "type": "string",
            "description": "Valor padr\u00e3o da vari\u00e1vel"
          }
        },
        "required": [
          "id",
          "nome",
          "tipo"
        ]
      },
      "default": []
    },
    "ativa": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "nome_categoria"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}