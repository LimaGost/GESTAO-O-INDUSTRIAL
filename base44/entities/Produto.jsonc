{
  "name": "Produto",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string"
    },
    "codigo": {
      "type": "string"
    },
    "categoria": {
      "type": "string"
    },
    "descricao": {
      "type": "string"
    },
    "unidade": {
      "type": "string",
      "default": "unidade"
    },
    "itens_por_caixa": {
      "type": "number",
      "default": 1
    },
    "preco": {
      "type": "number",
      "default": 0
    },
    "preco_unitario": {
      "type": "number",
      "default": 0
    },
    "preco_custo": {
      "type": "number",
      "default": 0
    },
    "estoque_atual": {
      "type": "number",
      "default": 0
    },
    "estoque_minimo": {
      "type": "number",
      "default": 0
    },
    "estoque_maximo": {
      "type": "number",
      "default": 0
    },
    "foto_url": {
      "type": "string"
    },
    "variacoes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "atributos_customizados": {
      "type": "object",
      "description": "Atributos din\u00e2micos espec\u00edficos por categoria",
      "default": {}
    },
    "alerta_ativo": {
      "type": "boolean",
      "default": false
    },
    "peso_liquido_kg": {
      "type": "number"
    },
    "peso_bruto_kg": {
      "type": "number"
    },
    "largura_cm": {
      "type": "number"
    },
    "altura_cm": {
      "type": "number"
    },
    "profundidade_cm": {
      "type": "number"
    },
    "tipo_produto": {
      "type": "string",
      "enum": [
        "marca_propria",
        "white_label"
      ],
      "default": "marca_propria",
      "description": "Tipo de produto: Marca Pr\u00f3pria ou White Label"
    },
    "wl_cliente_id": {
      "type": "string",
      "description": "ID do cliente White Label"
    },
    "wl_cliente_nome": {
      "type": "string",
      "description": "Nome comercial do cliente White Label"
    },
    "wl_logotipo_url": {
      "type": "string",
      "description": "URL do logotipo utilizado neste produto WL"
    },
    "wl_nome_comercial": {
      "type": "string",
      "description": "Nome comercial do produto para o cliente"
    },
    "wl_codigo_cliente": {
      "type": "string",
      "description": "C\u00f3digo interno do cliente para este produto"
    },
    "wl_obs_embalagem": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es de embalagem"
    },
    "wl_obs_rotulagem": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es de rotulagem"
    }
  },
  "required": [
    "nome"
  ]
}