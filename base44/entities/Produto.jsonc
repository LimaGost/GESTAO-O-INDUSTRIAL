{
  "name": "Produto",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string"
    },
    "codigo": {
      "type": "string"
    },
    "categoria": {
      "type": "string"
    },
    "descricao": {
      "type": "string"
    },
    "unidade": {
      "type": "string",
      "default": "unidade"
    },
    "itens_por_caixa": {
      "type": "number",
      "default": 1
    },
    "preco": {
      "type": "number",
      "default": 0
    },
    "preco_unitario": {
      "type": "number",
      "default": 0
    },
    "preco_custo": {
      "type": "number",
      "default": 0
    },
    "estoque_atual": {
      "type": "number",
      "default": 0
    },
    "estoque_minimo": {
      "type": "number",
      "default": 0
    },
    "estoque_maximo": {
      "type": "number",
      "default": 0
    },
    "foto_url": {
      "type": "string"
    },
    "variacoes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "atributos_customizados": {
      "type": "object",
      "description": "Atributos din\u00e2micos espec\u00edficos por categoria",
      "default": {}
    },
    "alerta_ativo": {
      "type": "boolean",
      "default": false
    },
    "peso_liquido_kg": {
      "type": "number",
      "description": "Peso l\u00edquido em quilogramas"
    },
    "peso_bruto_kg": {
      "type": "number",
      "description": "Peso bruto em quilogramas"
    },
    "largura_cm": {
      "type": "number",
      "description": "Largura em cent\u00edmetros"
    },
    "altura_cm": {
      "type": "number",
      "description": "Altura em cent\u00edmetros"
    },
    "profundidade_cm": {
      "type": "number",
      "description": "Profundidade em cent\u00edmetros"
    },
    "white_label": {
      "type": "boolean",
      "default": false,
      "description": "Produto White Label"
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        },
        {
          "user_condition": {
            "role": "estoquista"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        },
        {
          "user_condition": {
            "role": "estoquista"
          }
        },
        {
          "user_condition": {
            "role": "embalador"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        }
      ]
    }
  }
}