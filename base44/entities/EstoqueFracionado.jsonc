{
  "name": "EstoqueFracionado",
  "type": "object",
  "properties": {
    "produto_id": {
      "type": "string",
      "description": "ID do produto"
    },
    "produto_nome": {
      "type": "string",
      "description": "Nome do produto"
    },
    "produto_codigo": {
      "type": "string",
      "description": "C\u00f3digo/SKU do produto"
    },
    "quantidade": {
      "type": "number",
      "default": 0,
      "description": "Saldo de unidades avulsas (caixas desmontadas / sobras de produ\u00e7\u00e3o)"
    }
  },
  "required": [
    "produto_id",
    "produto_nome"
  ],
