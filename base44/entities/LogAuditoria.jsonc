{
  "name": "LogAuditoria",
  "type": "object",
  "properties": {
    "entidade": {
      "type": "string"
    },
    "entidade_id": {
      "type": "string"
    },
    "acao": {
      "type": "string"
    },
    "descricao": {
      "type": "string"
    },
    "usuario": {
      "type": "string"
    }
  },
  "required": [
    "entidade",
    "acao"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "diretor"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}