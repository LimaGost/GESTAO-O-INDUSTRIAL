{
  "name": "Descarte",
  "type": "object",
  "properties": {
    "ordem_producao_id": {
      "type": "string"
    },
    "ordem_producao_numero": {
      "type": "string"
    },
    "produto_id": {
      "type": "string"
    },
    "produto_nome": {
      "type": "string"
    },
    "quantidade": {
      "type": "number",
      "default": 0
    },
    "custo_unitario": {
      "type": "number",
      "default": 0
    },
    "custo_total": {
      "type": "number",
      "default": 0
    },
    "motivo": {
      "type": "string"
    },
    "descricao": {
      "type": "string"
    },
    "etapa_producao": {
      "type": "string"
    },
    "registrado_por": {
      "type": "string"
    },
    "data_descarte": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "produto_nome",
    "motivo"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        },
        {
          "user_condition": {
            "role": "maquinista"
          }
        },
        {
          "user_condition": {
            "role": "estoquista"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        }
      ]
    }
  }
}