{
  "name": "Pedido",
  "type": "object",
  "properties": {
    "numero": {
      "type": "string",
      "description": "N\u00famero do pedido"
    },
    "cliente_id": {
      "type": "string",
      "description": "ID do cliente"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "aguardando_estoque",
        "separacao",
        "separado",
        "expedido",
        "entregue",
        "cancelado"
      ],
      "default": "rascunho"
    },
    "data_pedido": {
      "type": "string",
      "format": "date"
    },
    "data_entrega_prevista": {
      "type": "string",
      "format": "date"
    },
    "itens": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": []
    },
    "valor_total": {
      "type": "number",
      "default": 0
    },
    "observacoes": {
      "type": "string"
    },
    "ordens_producao_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "white_label": {
      "type": "boolean",
      "default": false,
      "description": "Pedido White Label"
    },
    "white_label_marca": {
      "type": "string",
      "description": "Nome da marca/cliente para quem o produto White Label \u00e9 fabricado"
    },
    "destino_tipo": {
      "type": "string",
      "enum": [
        "retirada_fabrica",
        "retirada_unidade",
        "transportadora",
        "entrega_cliente"
      ],
      "description": "Tipo de destino/entrega do pedido"
    },
    "destino_unidade": {
      "type": "string",
      "description": "Nome da unidade de retirada (quando destino_tipo = retirada_unidade)"
    },
    "destino_transportadora": {
      "type": "string",
      "description": "Nome da transportadora (quando destino_tipo = transportadora)"
    },
    "destino_endereco": {
      "type": "string",
      "description": "Endere\u00e7o de entrega (quando destino_tipo = entrega_cliente)"
    }
  },
  "required": [
    "cliente_nome"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        },
        {
          "user_condition": {
            "role": "estoquista"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "gerente_producao"
          }
        }
      ]
    }
  }
}